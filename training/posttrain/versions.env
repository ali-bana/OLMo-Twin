# Immutable identity of the OLMo 2 0425-1B post-training reproduction (v1).
# Recipe: the 1B SFT and DPO commands of open-instruct's docs/olmo2.md as on
# main in Sep 2026. docs/olmo2.md does not exist at the pinned commit; its
# version at commit 89b4f62 passes --reduce_loss sum to SFT, which our runs
# omit, so the pinned default (mean) applies to both arms (see
# training/README.md).
OPEN_INSTRUCT_COMMIT=d19de7d27ac2af2cd1dcbf856dba1a2d077b37f4
OPEN_INSTRUCT_PATCH=open-instruct.patch   # keep the checkpoint ladder; one run directory for all ranks
# Container: see env/posttrain/Dockerfile.
# SFT (verbatim from docs/olmo2.md "1B"): dataset tulu-3-sft-olmo-2-mixture-0225,
# seq 4096, per-device 2 x accum 8 x 8 GPUs = eff.batch 128, lr 3e-5 linear,
# warmup 0.03, wd 0.0, 2 epochs, seed 1, bf16, DeepSpeed ZeRO-3, add_bos,
# tulu chat template, flash-attn, reduce_loss=mean (script default; command
# passes nothing). Our only additions: checkpointing every 1000 steps kept
# forever, offline/tracking flags, local model+tokenizer+dataset paths.
SFT_SEED=1
# DPO (same doc): olmo-2-0425-1b-preference-mix, seq 2048, per-device 8 x
# accum 2 x 8 GPUs = eff.batch 128, lr 2.5e-6 linear, warmup 0.1, 1 epoch,
# seed 111, dpo_norm loss, beta 5, ZeRO-2, gradient checkpointing.
DPO_SEED=111
# Dataset revisions. The runs passed revision main, which resolved to these
# commits (recorded as dataset_commit_hash in open-instruct's dataset-cache
# config.json).
SFT_DATASET_COMMIT=d91a0785ade02942520280fb484866fce41e448f   # allenai/tulu-3-sft-olmo-2-mixture-0225
DPO_DATASET_COMMIT=c6454f3d364622718a8ecd3d307e524febbba569   # allenai/olmo-2-0425-1b-preference-mix
# Baseline start point: official stage-2 ingredient3 (seed 42) endpoint (ingredient1 is seed 42069)
# step23852, converted OLMo->HF. Injected arm: our injection-v2 final
# checkpoint, converted identically.
