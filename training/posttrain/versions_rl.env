# Immutable identity of the OLMo 2 0425-1B RLVR reproduction (two GRPO stages
# after DPO = OLMo-2-0425-1B-RLVR1, then OLMo-2-0425-1B-Instruct).
# Recipe: open-instruct docs/olmo2.md "RLVR / 1B", the ORIGINAL commands, run
# by AI2 in April 2025 with the legacy grpo_vllm_thread_ray_gtrl.py, which is
# present at our pinned commit (OPEN_INSTRUCT_COMMIT in versions.env, the same
# checkout as SFT and DPO). AI2: 43 h per stage on 2 H100 nodes.
# Container: see env/posttrain-rlvr/Dockerfile (SFT/DPO image + vllm 0.8.2 + IB libs).
# Datasets (unchanged on the Hub since Nov 2024, so identical to AI2's runs;
# both already contamination-scanned, 0 hits):
RLVR1_DATASET=allenai/RLVR-GSM-MATH-IF-Mixed-Constraints  # rev 7dbd180f5440c0b90f2944e6efea934b85437a95
RLVR2_DATASET=allenai/RLVR-MATH                           # rev bd2a93551b503a395fadd1a740d957559cfe6f3c
# AI2's original commands load the tokenizer of allenai/OLMo-2-1124-7B-DPO
# (rev e34ea60adff2e575f4fe7569eaffd1b28509b6fd); verified identical to our
# DPO model's tokenizer (vocab, merges, added and special tokens).
RL_TOKENIZER_DIR=assets/hf_models/OLMo-2-1124-7B-DPO-tokenizer   # relative to the data root
RL_SEED=1
# 2,000,000 episodes / (4 prompts x 12 learners x 16 samples) = 2,604 steps
# per stage; checkpoints every 200 steps, as AI2 released them.
# For information only: the dataset-cache keys our runs computed
# (posttrain/dataset_cache/<key>), written by cache_datasets.sh rlvr. The keys
# hash the tokenizer and cache paths, so they differ on another machine;
# run_rlvr.sh does not check them. The first caching run, before README.md was
# in the HF cache, recorded dataset_commit_hash=null and wrote the same rows
# under 1d9b9805f9 / 07aa42d556; those are kept, so an offline run that cannot
# resolve the commit also finds its cache.
RLVR1_CACHE_TRAIN=ca846d0a14   # 29,689 prompts (29,946 before the 2048-token prompt filter)
RLVR1_CACHE_EVAL=6c4ad8f603    # 16 prompts
RLVR2_CACHE_TRAIN=7d94fbb5ba   # 7,499 prompts (7,500 before the filter)
RLVR2_CACHE_EVAL=c69b1d511e    # 16 prompts
# AI2's released OLMo-2-0425-1B-Instruct is byte-identical to the step_2000
# branch of its stage-2 run (not the final step 2604); RLVR1 is the final model.
